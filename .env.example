# Copia este archivo como .env y rellena los valores. Ver README.md, paso a paso.

# --- Servidor ---
PORT=3000
# URL pública donde corre el bot (sin / al final). Ej: https://mi-bot.onrender.com
BASE_URL=
# Una cadena larga y aleatoria (firma los enlaces de "conectar calendario").
APP_SECRET=
# Postgres. Ej: postgres://usuario:clave@host:5432/bot
DATABASE_URL=

# --- Asistente ---
ASSISTANT_NAME=Sofía
DEFAULT_TIMEZONE=America/Lima
# Números que pueden usar el bot, separados por coma (vacío = cualquiera). Ej: +51987654321
ALLOWED_NUMBERS=

# --- Claude (IA) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Twilio (WhatsApp + llamadas) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp del bot, formato +código país (no puede ser de EE. UU./Canadá para llamar).
TWILIO_WHATSAPP_NUMBER=
# Plantilla con botón "Permitir llamadas" (VOICE_CALL_REQUEST). Empieza con HX...
TWILIO_CALL_PERMISSION_CONTENT_SID=
# Plantilla de recordatorio con una variable {{1}}, para avisos fuera de las 24 h. Empieza con HX...
TWILIO_REMINDER_CONTENT_SID=
# Déjalo en true en producción. Solo en false para pruebas locales.
VALIDATE_TWILIO_SIGNATURE=true

# Voz de las llamadas y idioma del reconocimiento de voz.
TTS_VOICE=Polly.Mia-Neural
SPEECH_LANGUAGE=es-MX

# --- Google Calendar (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Outlook / Teams (opcional) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Notas de voz (opcional): transcripción con OpenAI Whisper ---
OPENAI_API_KEY=
